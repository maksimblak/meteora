# Interpolation file of the acceptance smoke (passed with --env-file instead of .env).
# It exists so that an operator's real .env (RPC URL, executor tokens, wallet paths) is
# never read by the acceptance stack. Everything stays empty: SHADOW, no RPC, no wallet.
# The smoke test passes its throwaway operator token through the process environment.
TRADING_MODE=
SOLANA_RPC_URL=
EXECUTOR_URL=
EXECUTOR_INTERNAL_TOKEN=
EXECUTOR_INTERNAL_TOKEN_FILE=
EXECUTOR_APPROVAL_SECRET_FILE=
GMGN_URL=
GMGN_API_KEY=
GMGN_API_KEY_FILE=
